#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: bright set <0-100> | bright chg <+N|-N>"
    echo "Control external monitor brightness via DDC/CI (m1ddc)"
}

if [[ $# -lt 2 ]]; then
    usage
    exit 1
fi

if ! command -v m1ddc >/dev/null 2>&1; then
    echo "Error: m1ddc is not installed (brew install m1ddc)" >&2
    exit 1
fi

cmd="$1"
value="$2"

case "$cmd" in
    set)
        if ! [[ "$value" =~ ^[0-9]+$ ]]; then
            echo "Error: brightness must be a number" >&2
            exit 1
        fi
        if [[ "$value" -lt 0 || "$value" -gt 100 ]]; then
            echo "Error: brightness must be between 0 and 100" >&2
            exit 1
        fi
        m1ddc set luminance "$value"
        ;;
    chg)
        if ! [[ "$value" =~ ^[+-][0-9]+$ ]]; then
            echo "Error: change must be signed (e.g. +5 or -5)" >&2
            exit 1
        fi
        m1ddc chg luminance "$value"
        ;;
    *)
        usage
        exit 1
        ;;
esac
