[alias]
	fomo = "!f() { b=$(git config init.defaultBranch 2>/dev/null); if git show-ref -q --verify refs/heads/$b 2>/dev/null; then :; elif git show-ref -q --verify refs/heads/main; then b=main; else b=master; fi; git fetch origin && git rebase --autostash origin/$b; }; f"
	lg = "!git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all"
	nuke = "!git add --all && git stash && git stash clear"

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = false

[core]
	editor = "nvim"
	fsmonitor = true

[fetch]
	prune = true
	writeCommitGraph = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[rebase]
	updateRefs = true

[rerere]
	enabled = true

[tag]
	gpgSign = false

