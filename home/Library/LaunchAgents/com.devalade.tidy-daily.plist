<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.devalade.tidy-daily</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>exec "$HOME/.local/bin/tidy-daily"</string>
	</array>

	<!-- Every morning at 09:00 -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/macuser/.local/bin:/Users/macuser/.opencode/bin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/macuser/Library/Logs/tidy-daily.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/macuser/Library/Logs/tidy-daily.stderr.log</string>
</dict>
</plist>
